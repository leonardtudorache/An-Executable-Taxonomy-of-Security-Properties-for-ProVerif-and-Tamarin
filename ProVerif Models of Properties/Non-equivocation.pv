free c: channel.
type skey. type pkey.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, sk: skey; checksign(sign(m, sk), pk(sk)) = m.

free skH: skey [private].   (* host — leaked below *)
free skT: skey [private].   (* trinket attestation key — never leaked *)

table used(bitstring, bitstring).

event Attested(bitstring, bitstring).
event Accepted(bitstring, bitstring).

(* Hardware guarantee: a counter slot is consumed at most once.
   This is the trusted-component assumption, discharged by the
   hardware, not by ProVerif. *)
restriction ctr: bitstring, m1: bitstring, m2: bitstring;
    event(Attested(ctr, m1)) && event(Attested(ctr, m2)) ==> m1 = m2.

query ctr: bitstring, m1: bitstring, m2: bitstring;
    event(Accepted(ctr, m1)) && event(Accepted(ctr, m2)) ==> m1 = m2.

query ctr: bitstring, m: bitstring; event(Accepted(ctr, m)).

let trinket =
    in(c, (ctr: bitstring, m: bitstring));
    get used(=ctr, m_old) in
    ( if m = m_old then out(c, sign((ctr, m), skT)) )
    else
    (
        event Attested(ctr, m);
        insert used(ctr, m);
        out(c, sign((ctr, m), skT))
    ).

let verifier =
    in(c, (ctr: bitstring, m: bitstring, sH: bitstring, sT: bitstring));
    if checksign(sH, pk(skH)) = m then
    if checksign(sT, pk(skT)) = (ctr, m) then
    event Accepted(ctr, m).

process
    out(c, pk(skH)); out(c, pk(skT));
    out(c, skH);
    ( !trinket | !verifier )