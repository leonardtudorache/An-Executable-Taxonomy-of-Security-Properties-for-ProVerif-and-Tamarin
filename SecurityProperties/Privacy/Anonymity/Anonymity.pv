(* Anonymity protocol model *)
(* Anonymity (Section 4.2.4): an agent's real identifier must stay
   hidden from the attacker even while legitimately taking part. The
   attacker should never learn p_id despite seeing the encrypted
   traffic below. *)

free c: channel.
type key.

free k: key [private].
free p_id: bitstring [private].

(* Cryptographic primitives *)
fun enc(bitstring, key): bitstring.
reduc forall x:bitstring, y:key; dec(enc(x,y),y) = x.

  
(* Anonymity query *)
query attacker(p_id).

(* --- Executability --- *)
event QReceived(bitstring).
query m: bitstring; event(QReceived(m)).

let P(p_id: bitstring) = 
    new m: bitstring;
    let m_enc = enc((m, p_id), k) in
    out(c, m_enc).

let Q() = 
    in(c, enc_msg: bitstring);
    let (m: bitstring, new_id: bitstring) = dec(enc_msg, k) in
    event QReceived(m);
    0.

process
  P(p_id) | Q()
