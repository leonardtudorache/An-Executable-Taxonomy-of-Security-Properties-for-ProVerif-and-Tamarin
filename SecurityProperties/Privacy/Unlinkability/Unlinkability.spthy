// tamarin-prover --diff --prove Unlinkability.spthy

/* Unlinkability (Section 4.2.4): the taxonomy paper's own worked
   example, checked via observational equivalence (Tamarin's diff):
   Session_Two may use U or V -- if the attacker can't tell which,
   unlinkability holds. Run with: tamarin-prover --diff --prove. */

theory IdentityPrivacy
begin

builtins: hashing

/* 1. Setup: Generate the private identities */
rule Setup:
    [ Fr(~U), Fr(~V) ]
  --[ OnlyOnce() ]->
    [ !ID_U(~U), !ID_V(~V) ]

/* 2. Session One: Always uses Identity U */
rule Session_One:
    [ !ID_U(~U), Fr(~r1) ]
  -->
    [ Out(h(<~U, ~r1>)) ]

/* 3. Session Two: The 'Choice' rule
   Uses diff(U, V) to check for observational equivalence.
*/
rule Session_Two:
    [ !ID_U(~U), !ID_V(~V), Fr(~r2) ]
  -->
    [ Out(h(<diff(~U, ~V), ~r2>)) ]

/* --- Restrictions --- */
restriction OnlyOnce:
    "All #i #j. OnlyOnce() @ i & OnlyOnce() @ j ==> #i = #j"

end