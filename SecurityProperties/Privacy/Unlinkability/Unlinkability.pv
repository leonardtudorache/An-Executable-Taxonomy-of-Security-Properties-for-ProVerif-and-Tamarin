(*
  Unlinkability (Section 4.2.4): an outside observer must not tell two
  runs of the same process apart, even if they secretly use different
  identities. This is the taxonomy paper's own worked example,
  checked via observational equivalence (ProVerif's choice[...]):
  one session always uses U, the other may use U or V.
*)

free c : channel.
type uid. type nonce.
fun pid(uid, nonce): bitstring.

free U, V : uid [private].

(* Sanity check: not possible here. ProVerif rejects a biprocess that
   also carries correspondence queries ("Queries are incompatible with
   choice"), so the reachability query of the other models cannot be
   added. session() is a plain output with no guard, so it always runs;
   if it ever grows a guard, re-check that the equivalence is not
   holding vacuously. *)

(* --- Roles --- *)

(* Session: outputs a pseudonym built from a fresh nonce *)
let session(u: uid) =
  new r: nonce;
  (* out(c, u). *)
  out(c, pid(u, r)).

(* Setup: biprocess -> left = both sessions use U; right = second uses V *)
process
  ( !session(U) | !session(choice[U, V]) )
