(*Remark! protocol with Fix - Mark Privacy *)
(*Honest:  NET, Exam Authority, Candidate and Examiner in question *)
(*Dishonest Co-Candidates and Co-Examiners *)
(*Special roles to identify the honest parties *)
(*Result: No attack.*)


free ch: channel.
(*Public channels representing the bulletin-boards: NET publishes on bbn, and Exam Authority publishes on bba*)
free bbn: channel.
free bba: channel.

free mark1:bitstring.
free mark2:bitstring.
free label: bitstring.

type identity.
type pkey.
type skey.
type coins.
type role.

(* Roles to identify dishonest Candidates and Examiners *)
free C: role.
free E: role.

(* Roles to identify the honest Candidate and the honest Examiner *)
free C1: role.
free E1: role.

table publickey(role, bitstring, pkey).

(*event ev_0.
query event(ev_0).

event ev_1.
query event(ev_1).

event ev_2.
query event(ev_2).

event ev_3.
query event(ev_3).

event ev_4.
query event(ev_4).



(* Pseudonym *)
fun pk(skey): pkey.
fun pseudo_pub(pkey,bitstring):pkey.
fun pseudo_priv(skey,bitstring):skey. 
fun exp(bitstring):bitstring.
fun find_partition(bitstring, bitstring):bitstring.
fun hash(bitstring, bitstring, pkey, bitstring):bitstring.

reduc forall  k: skey, rce:bitstring; checkpseudo(pseudo_pub(pk(k),rce), pseudo_priv(k,exp(rce))) = true.

(* El-Gamal Probabilistic Public key encryption *)
fun int_encrypt(bitstring, pkey, coins): bitstring.
fun decrypt(bitstring,skey):bitstring
  reduc 
    forall m: bitstring, k: skey, r:coins;  decrypt(int_encrypt(m,pk(k),r),k) = m
    otherwise  forall m: bitstring, k: skey, r:coins, rce:bitstring;  decrypt(int_encrypt(m,pseudo_pub(pk(k),rce),r), pseudo_priv(k,exp(rce))) = m.

letfun encrypt(x:bitstring, y:pkey)= new r:coins; int_encrypt(x,y,r).

(* Signature *)
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; getmess(sign(m,k)) = m.
fun checksign(bitstring, pkey):bitstring
  reduc 
     forall m: bitstring, k: skey; checksign(sign(m,k), pk(k)) = m
     otherwise forall m: bitstring, k: skey, rce:bitstring; checksign(sign(m,pseudo_priv(k,exp(rce))),pseudo_pub(pk(k),rce)) = m.


(*---------------Protocol-----------------*)

(*----------NET-----------------*)
let NET (skN:skey, pkA:pkey, rc:bitstring) =
in(ch, (R: role));
get publickey(=R, rx, pkX) in
let hx = exp(rx) in
let pseudo_X = pseudo_pub(pkX,rx) in 
let spseX = sign ((pseudo_X, hx, R), skN) in 
out(bbn, ( pseudo_X, hx, R, spseX));

(*Reveal RC*)
let signetX = sign( (rc), skN) in
let encsignetX = encrypt ( (rc, signetX), pkA) in
out(ch, encsignetX).

(*----------Exam Authority-----------------*)
let EA (skA:skey, pkN:pkey, ques:bitstring, cand:role, ex:role, map: bitstring) =

in(bbn, (pseudo_C:pkey, hc:bitstring, r: role, spseC:bitstring));
if (pseudo_C, hc, cand) = checksign(spseC, pkN) && r = cand then 
(*The candidate is considered registered when the Exam Authority receives his pseudonym and successfully checks the signature of the NET*)
(* Examination *)
let sques = sign(ques, skA) in
let eques = encrypt( (ques,sques), pseudo_C) in 
out(bba, eques);
in(ch, eca:bitstring);
let ((=ques, ans:bitstring, =pseudo_C), sca:bitstring) = decrypt(eca, skA) in 
if (ques, ans, pseudo_C) = checksign(sca, pseudo_C) then
(*At this point, Exam Authority collects the exam form  (ques, ans) from the candidate with pseudonym pseudo_C*)
new alpha: bitstring;
let ca = hash(ques, ans, pseudo_C, alpha) in 
let sca' = sign(ca, skA)  in 
let eca' = encrypt((ca, sca'), pseudo_C) in 
out(bba, eca');

(* Marking *)
in(bbn, (pseudo_E:pkey, he:bitstring, rolet: role, spseE:bitstring));
if (pseudo_E, he, rolet) = checksign(spseE, pkN) && rolet = ex then 
(*Fix: the pseudonym pseudo_E of the target Examiner is added to the signed form --distributed by the Exam Authority-- to be marked. 
So, only the intended Examiner will mark the form after checking the signature of the Exam Authority*)


(*The Exam Authority distributed the form (pseudo_C,ques,ans) identified by pseudo_C (id_form = pseudo_C) to the Examiner pseudo_E*)
out(bba, sign(label, skA));
in(ch, ema:bitstring);
let part = find_partition(label, map) in
let ((mark:bitstring, =part), sma:bitstring) = decrypt(ema, skA) in
if (mark, part) = checksign(sma, pseudo_E) then
let cm = sign(ema, skA) in
let cms = encrypt(cm, pseudo_C) in
out(ch, (cms,alpha));
(*Reveal ID*)
in(ch, encsignetX: bitstring).

(*----------Candidate-----------------*)

let Cand (skC:skey, pkA:pkey, pkN:pkey, ans:bitstring, rl:role) =

(* Cand Registration *)
in(bbn, (pseudo_C:pkey, hc:bitstring, r: role, spseC:bitstring));
if (pseudo_C, hc, rl) = checksign(spseC, pkN) && r = rl then 
let priv_C = pseudo_priv(skC, hc) in 
if checkpseudo(pseudo_C, priv_C) =true then 
(* Examination *)
in(bba, eques:bitstring);
let (ques: bitstring, sques:bitstring) = decrypt(eques, priv_C) in
if ques=checksign(sques, pkA) then
let ca = (ques, ans, pseudo_C) in 
let sca = sign(ca,priv_C) in 
let eca = encrypt((ca, sca), pkA) in 
(*The candidate pseudo_C  submits his form (ques, ans)*)
out(ch, eca);
in(bba, eca':bitstring);
let (eca_h:bitstring, sca':bitstring) = decrypt(eca', priv_C) in 


(*let ((=ques, =ans, =pseudo_C, mark:bitstring), sma:bitstring) = decrypt(ema', priv_C) in 
if (ques, ans, pseudo_C, mark) = checksign(sma, pkA) then*) 0.


(*----------Examiner-----------------*)

let Ex (skE:skey, pkA:pkey, pkN:pkey, mark:bitstring, rl:role, map: bitstring) =
(* Examiner Registration *)
in(bbn, (pseudo_E:pkey, he:bitstring, r: role, spseE:bitstring));
if (pseudo_E, he, rl) = checksign(spseE, pkN) && r = rl then 
let priv_E = pseudo_priv(skE, he) in 
if checkpseudo(pseudo_E, priv_E) =true then 

(* Marking *)
in(bba, ema':bitstring);
let (label1:bitstring) = checksign(ema', pkA) in
let part = find_partition(label1, map) in
let ma = (mark, part) in 
let sma = sign(ma,priv_E) in 
let ema = encrypt((ma, sma), pkA) in
out(ch, ema).


(*----------Main-----------------*)
process

(

(*Products of the secret exponent values of the servers (represented by the NET): rc for the candidates and re for the examiners.*)
new rc: bitstring;
new re: bitstring;
new map: bitstring;
out(ch, rc);
out(ch, re);

(*We assume one NET and one Exam Authority*)
new skA: skey; let pkA = pk(skA) in out (ch,  pkA); 
new skN: skey; let pkN = pk(skN) in out (ch, pkN); 


(* Honest Parties *)
!( NET(skN, pkA, rc)) |
 ( new ques:bitstring;  EA(skA, pkN, ques, C, E, map) )   |
 ( new ques:bitstring;  EA(skA, pkN, ques, C1, E1, map) ) | 
 ( new skC: skey; let pkC = pk(skC) in out (ch, pkC);  new ans:bitstring; insert publickey(C1, rc, pkC); Cand(skC, pkA, pkN, ans, C1) ) |
 ( new skE: skey; let pkE = pk(skE) in out (ch, pkE);  new mark:bitstring; insert publickey(E1, re, pkE); Ex(skE, pkA, pkN, choice[mark1,mark2], E1, map) ) |
(* Dishonest Co-Candidate and Co-Examiner *)
 ( new skC: skey; let pkC = pk(skC) in out (ch, (pkC, skC));  in(ch, ans:bitstring); insert publickey(C, rc, pkC)  ) |
 ( new skE: skey; let pkE = pk(skE) in out (ch, (pkE, skE));  in(ch, mark:bitstring); insert publickey(E, re, pkE) )

)
