(* 
    DESCRIPTION: Only enrollment and pseudonym provisioning phase
    NOTES:
	- one vehicle tested, multiple other vehicles
	- multiple attackers
	- no phases (only enrollment, pseudonym certificate provisioning, message exchange)
	- no revocation phase
	- only one revoked vehicle in the revocation list
*)


free ch:channel. 	(* Public channel *)

type pkey.
type skey.
type result.
type gmskey.
type gskey.
type gpkey.
type certype.

const revoke_request:bitstring.
const groupkey_request:bitstring.
const groupkey_response:bitstring.
const rsu:bitstring.

(* Asymmetric signature *)
fun pk(skey):pkey.
fun sign(bitstring, skey):bitstring.
fun ok():result.
reduc forall m:bitstring, sk:skey; checksign(sign(m, sk), m, pk(sk)) = ok().

(* Asymmetric encryption *)
fun aenc(bitstring, pkey):bitstring.
reduc forall m:bitstring, sk:skey; adec(aenc(m, pk(sk)), sk) = m.

(* Certificate *)
fun cert(bitstring, pkey, skey):certype [private].
reduc forall vid:bitstring, vpk:pkey, sk:skey; checkcert(cert(vid, vpk, sk), pk(sk)) = ok().
reduc forall vid:bitstring, vpk:pkey, sk:skey; getpk(cert(vid, vpk, sk)) = vpk.
reduc forall vid:bitstring, vpk:pkey, sk:skey; getid(cert(vid, vpk, sk)) = vid.

(* Group signature *)
					(* Group master secret key: gmsk *)
fun gpk(gmskey):gpkey.			(* Group public key: gpk(gmsk) *)
fun gsk(bitstring, gmskey):gskey.		(* Vehicle private group secret key: gsk(vid, gmsk) *)
fun gok():result.

(* Pseudonym certificate *)
fun pseudocert(pkey, gskey):certype.
reduc forall pseudopk:pkey, vid:bitstring, gmsk:gmskey; checkpseudocert(pseudocert(pseudopk, gsk(vid, gmsk)), gpk(gmsk)) = gok().
reduc forall pseudopk:pkey, vid:bitstring, gmsk:gmskey; getpseudopk(pseudocert(pseudopk, gsk(vid, gmsk))) = pseudopk.
reduc forall pseudopk:pkey, vid:bitstring, gmsk:gmskey; gopen(pseudocert(pseudopk, gsk(vid, gmsk)), gmsk) = vid.
reduc forall pseudopk:pkey, vid:bitstring, gmsk:gmskey; getvid(pseudocert(pseudopk, gsk(vid, gmsk))) = vid [private].


(* Events *)
event VehicleCreated(bitstring).
event AttackerGetsEnrollmentCertificate(bitstring, pkey).
event ValidGroupPrivateKeyReceived(bitstring, gskey, gpkey).
event ValidGroupPrivateKeySent(bitstring, gskey, gpkey).


event ValidGroupKeyRequestReceived(skey, bitstring, bitstring).
event ValidGroupKeyRequestSent(bitstring, bitstring).
event RevokedCannotGetGroupKey(bitstring).
event ValidMessageSent(bitstring, certype, bitstring).
event PseudoCertCreated(bitstring, skey).
event ValidMessageReceived(bitstring, bitstring).
event RevocationAsked(bitstring, certype, certype).
event ValidRevocationReportReceived(certype, certype).
event RevokedVid(bitstring).
event AlreadyRevoked(bitstring).
event ValidMessageReceivedSenderVid(bitstring, bitstring).
event CASKReveal(skey).
event CAGMSKReveal(gmskey).

free vid:bitstring [private].
free revokedvid:bitstring [private].
free anonymousvid:bitstring [private].

(* Revoked certificates table *)
table revokedcerts(bitstring).		(* vid of the revoked vehicles *)


(* Queries *)

(* ANONYMITY: the attacker cannot discover the vehicle that self-certified its certificate using group signature 
   i.e, the adversary cannot distinguish whether the certificate is signed by the vehicle or by any other member 
   of the group
   (P; let vpseudocert = pseudocert(vpseudopk, vgsk); ...) ≈ (P; let vpseudocert = pseudocert(vpseudopk, vgsk); ...) |P{anonymousgsk/vgsk}
   (P; let vpseudocert = pseudocert(vpseudopk, vgsk); ...) ≈ (P; let vpseudocert = pseudocert(vpseudopk, anonymousgsk); ...)
   i.e., starting from a group signature, the attacker cannot distinguish who performed the signature
   	-> let vpseudocert = pseudocert(vpseudopk, choice[vgsk, anonymousgsk])

   NOTE:
   - if we output X = pseudocert(vpseudopk, anonymousgsk), obs. equivalence is broken
	The attacker simply checks if pseudocert(vpseudopk, choice[vgsk, anonymousgsk]) == X
   - if we output X = anonymousgsk, obs. equivalence is broken
	The attacker takes pseudocert(vpseudopk, choice[vgsk, anonymousgsk]), extracts the vpseudopk and compute pseudocert(vpseudopk,
	anonymousgsk). Then, it checks if this term is equal to X
	Anyway, the attacker is not expected to have anonymousgsk
   - if we output anonymousvid, obs. equivalence still holds
	Because the attacker does not know gmsk, it cannot compute gsk(anonymousvid, gmsk) to be used to sign the pseudocert
	However, if the attacker also has a valid enrollment certificate and sk associated to anonymousvid, it can request
	gsk(anonymousvid, gmsk) to the RSU and break the obs. equivalence. Anyway, the attacker is not expected to have any of 
	this information
*)


let VehicleSendMessages(vid:bitstring, vgsk:gskey, anonymousgsk:gskey) = 
	(* Create the pseudonym certificate *)
	new vpseudosk:skey;
	let vpseudopk = pk(vpseudosk) in
	let vpseudocert = pseudocert(vpseudopk, choice[vgsk, anonymousgsk]) in
	event PseudoCertCreated(vid, vpseudosk);
	
	(* Vehicle can send multiple messages with the same pseudocert *)
	!(	(* Broadcast message to send *)
		new m:bitstring;
		(* Sign the message *)
		let signm = sign(m, vpseudosk) in
		event ValidMessageSent(vid, vpseudocert, m);
		out(ch, (m, signm, vpseudocert))
		(* out(ch, pseudocert(vpseudopk, anonymousgsk)) *)
		(* out(ch, anonymousgsk) *)
		(* out(ch, anonymousvid) *)
	).


let VehicleReceiveMessage(vid:bitstring, vgpk:gpkey) = 
	in(ch, (m:bitstring, signm:bitstring, vpseudocert:certype));
	(* Check pseudonym certificate*)
	if checkpseudocert(vpseudocert, vgpk) = gok() then
	(* Check message signature *)
	let vpseudopk = getpseudopk(vpseudocert) in
	if checksign(signm, m, vpseudopk) = ok() then
	
	(* Correct message *)
	event ValidMessageReceived(vid, m);
	event ValidMessageReceivedSenderVid(getvid(vpseudocert), m).
	

let VehicleRequestGroupKey(vid:bitstring, vsk:skey, vcert:certype, capk:pkey, anonymousgsk:gskey) =
	(* Vehicle gets the rsu cert from broadcast message *)
	in(ch, rsucert:certype);
	if getid(rsucert) = rsu then
	if checkcert(rsucert, capk) = ok() then
	let rsupk = getpk(rsucert) in

	(* Request group private and public key *)
	new nonce:bitstring;
	let req = (groupkey_request, nonce) in
	let signreq = sign(req, vsk) in
	let encsignreq = aenc((req, signreq, vcert), rsupk) in
	
	event ValidGroupKeyRequestSent(vid, nonce); 
	out(ch, encsignreq);
	in(ch, encsignresp:bitstring);
	
	(* Decrypt the response *)
	let (resp:bitstring, signature:bitstring) = adec(encsignresp, vsk) in
	(* Check signature *)
	if checksign(signature, resp, rsupk) = ok() then
	(* Check vid in the response *)
	let (=groupkey_response, =vid, vgsk:gskey, vgpk:gpkey, =nonce) = resp in
	
	event ValidGroupPrivateKeyReceived(vid, vgsk, vgpk);

	( !VehicleSendMessages(vid, vgsk, anonymousgsk) | !VehicleReceiveMessage(vid, vgpk) ).
	

		
let RSUReleaseGroupKey(gmsk:gmskey, rsusk: skey, rsucert:certype, capk:pkey) = 
	in(ch, encsignreq:bitstring);
	(* Decrypt the request *)
	let (req:bitstring, signreq:bitstring, vcert:certype) = adec(encsignreq, rsusk) in
	
	let (=groupkey_request, nonce:bitstring) = req in
	(* Check vehicle enrollment certificate *)
	if checkcert(vcert, capk) = ok() then

	let vpk = getpk(vcert) in
	let vid = getid(vcert) in
	(* Check if the vehicle is revoked *)
	get revokedcerts(=vid) in 
	event RevokedCannotGetGroupKey(vid); 0 
	else
	(* Check signature on request *)
	if checksign(signreq, req, vpk) = ok() then

	event ValidGroupKeyRequestReceived(rsusk, vid, nonce);
	
	(* Create new group private secret key *)
	let vgsk = gsk(vid, gmsk) in
	let resp = (groupkey_response, vid, vgsk, gpk(gmsk), nonce) in
	let signresp = sign(resp, rsusk) in
	let encsignresp = aenc((resp, signresp), vpk) in
	
	event ValidGroupPrivateKeySent(vid, vgsk, gpk(gmsk));
	out(ch, encsignresp).
	


process  
	(* Create CA public key and private key *)
	new cask:skey;
	let capk = pk(cask) in
	out(ch, capk);
	(* Create RSU group master secret key, public key and private key, certificate *)
	new gmsk:gmskey; new rsusk:skey; 
	let rsupk = pk(rsusk) in
	let rsucert = cert(rsu, rsupk, cask) in
	out(ch, (rsupk, rsucert));
	(* Create revoked vehicle *)
	event RevokedVid(revokedvid);
	insert revokedcerts(revokedvid);
	(* Anonymous gsk to test anonymity *)
	let anonymousgsk = gsk(anonymousvid, gmsk) in
	(* Create "our" vehicle *)
	(	(* My enrollment certificate *)
		new vsk:skey; 
		let vpk = pk(vsk) in
		let vcert = cert(vid, vpk, cask) in
		event VehicleCreated(vid);
		VehicleRequestGroupKey(vid, vsk, vcert, capk, anonymousgsk)
	)
	(* Create other vehicles *)
	|!(	(* Other vehicle enrollment certificate *)
		new ovid:bitstring;
		new ovsk:skey; 
		let ovpk = pk(ovsk) in
		let ovcert = cert(ovid, ovpk, cask) in
		event VehicleCreated(ovid);
		VehicleRequestGroupKey(ovid, ovsk, ovcert, capk, anonymousgsk)
	)
	(* Create attackers *)
	|!(	(* Attacker enrollment certificate *)
		new attvid:bitstring;
		new attsk:skey;
		let attpk = pk(attsk) in
		let attcert = cert(attvid, attpk, cask) in
		event VehicleCreated(attvid);
		event AttackerGetsEnrollmentCertificate(attvid, attpk);
		out(ch, (attvid, attsk, attcert))
	)	
	| !RSUReleaseGroupKey(gmsk, rsusk, rsucert, capk)

