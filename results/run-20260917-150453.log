  rule (modulo AC) Auctioneer_Receive_And_Win:
     [ In( <<p, id, n>, sig> ), !PkB( pkB ), Fr( ~win_confirm ) ]
    --[ Eq( z, true ), Won( p, id ) ]->
     [ Out( ~win_confirm ) ]
    variants (modulo AC)
    1. id    = id.8
       n     = n.8
       p     = p.8
       pkB   = pkB.8
       sig   = sig.8
       z     = verify(sig.8, h(<p.8, id.8, n.8>), pkB.8)
    
    2. id    = x.8
       n     = x.9
       p     = x.10
       pkB   = pk(x.11)
       sig   = sign(h(<x.10, x.8, x.9>), x.11)
       z     = true
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction OnlyOnce:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  */

lemma NonRepudiation:
  all-traces
  "∀ p id #i.
    (Won( p, id ) @ #i) ⇒ (∃ #j. (Bid( p, id ) @ #j) ∧ (#j < #i))"
