builtins: diffie-hellman
functions: fst/1, h/1, kdf/2, pair/2, pk/1, sdec/2, senc/2, sign/2,
           snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Initialize_Identities:
   [ Fr( ~skA ), Fr( ~skB ) ]
  --[ UniqueKeys( ) ]->
   [
   !Ltk( $A, ~skA ), !Pk( $A, pk(~skA) ), !Ltk( $B, ~skB ),
   !Pk( $B, pk(~skB) ), Out( pk(~skA) ), Out( pk(~skB) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Initialize_Shared_State:
   [ Fr( ~rk0 ) ]
  --[ UniqueState( ) ]->
   [
   !Rk0Store( $A, $B, ~rk0 ), State_Alice( $A, $B, ~rk0 ),
   State_Bob( $A, $B, ~rk0 )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_RK:
   [ !Rk0Store( $A, $B, rk0 ) ] --[ Compromise( $A, $B ) ]-> [ Out( rk0 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Alice_Send_DH:
   [ State_Alice( $A, $B, rk0 ), !Ltk( $A, skA ), Fr( ~expA ) ]
  -->
   [
   Out( <'g'^~expA, sign('g'^~expA, skA)> ),
   St_Alice_1( $A, $B, rk0, ~expA )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Alice_Complete_Healing_And_Send:
   [
   St_Alice_1( $A, $B, rk0, ~expA ), In( <gb, sigB> ), !Pk( $B, pkB ),
   Fr( ~secret_msg )
   ]
  --[
  Eq( verify(sigB, gb, pkB), true ), Heal( $A, $B, h(kdf(rk0, gb^~expA)) ),
  Send( $A, $B, ~secret_msg )
  ]->
   [ Out( senc(~secret_msg, h(kdf(rk0, gb^~expA))) ) ]

  /*
  rule (modulo AC) Alice_Complete_Healing_And_Send:
     [
     St_Alice_1( $A, $B, rk0, ~expA ), In( <gb, sigB> ), !Pk( $B, pkB ),
     Fr( ~secret_msg )
     ]
    --[
    Eq( z.1, true ), Heal( $A, $B, h(kdf(rk0, z)) ),
    Send( $A, $B, ~secret_msg )
    ]->
     [ Out( senc(~secret_msg, h(kdf(rk0, z))) ) ]
    variants (modulo AC)
     1. ~expA = ~expA.11
        gb    = gb.11
        pkB   = pkB.11
        sigB  = sigB.11
        z     = gb.11^~expA.11
        z.1   = verify(sigB.11, gb.11, pkB.11)
    
     2. ~expA = ~x.11
        gb    = x.13^inv(~x.11)
        pkB   = pkB.14
        sigB  = sigB.14
        z     = x.13
        z.1   = verify(sigB.14, x.13^inv(~x.11), pkB.14)
    
     3. ~expA = ~x.11
        gb    = x.13^inv(~x.11)
        pkB   = pk(x.14)
        sigB  = sign(x.13^inv(~x.11), x.14)
        z     = x.13
        z.1   = true
    
     4. ~expA = ~x.11
        gb    = x.13^inv((~x.11*x.14))
        pkB   = pkB.15
        sigB  = sigB.15
        z     = x.13^inv(x.14)
        z.1   = verify(sigB.15, x.13^inv((~x.11*x.14)), pkB.15)
    
     5. ~expA = ~x.11
        gb    = x.13^inv((~x.11*x.14))
        pkB   = pk(x.15)
        sigB  = sign(x.13^inv((~x.11*x.14)), x.15)
        z     = x.13^inv(x.14)
        z.1   = true
    
     6. ~expA = ~x.11
        gb    = x.13^(x.14*inv(~x.11))
        pkB   = pkB.15
        sigB  = sigB.15
        z     = x.13^x.14
        z.1   = verify(sigB.15, x.13^(x.14*inv(~x.11)), pkB.15)
    
     7. ~expA = ~x.11
        gb    = x.13^(x.14*inv(~x.11))
        pkB   = pk(x.15)
        sigB  = sign(x.13^(x.14*inv(~x.11)), x.15)
        z     = x.13^x.14
        z.1   = true
    
     8. ~expA = ~x.11
        gb    = x.13^(x.14*inv((~x.11*x.15)))
        pkB   = pkB.16
        sigB  = sigB.16
        z     = x.13^(x.14*inv(x.15))
        z.1   = verify(sigB.16, x.13^(x.14*inv((~x.11*x.15))), pkB.16)
    
     9. ~expA = ~x.11
        gb    = x.13^(x.14*inv((~x.11*x.15)))
        pkB   = pk(x.16)
        sigB  = sign(x.13^(x.14*inv((~x.11*x.15))), x.16)
        z     = x.13^(x.14*inv(x.15))
        z.1   = true
    
    10. ~expA = ~expA.13
        gb    = x.11
        pkB   = pk(x.12)
        sigB  = sign(x.11, x.12)
        z     = x.11^~expA.13
        z.1   = true
    
    11. ~expA = ~expA.13
        gb    = x.11^x.12
        pkB   = pkB.13
        sigB  = sigB.13
        z     = x.11^(x.12*~expA.13)
        z.1   = verify(sigB.13, x.11^x.12, pkB.13)
    
    12. ~expA = ~expA.14
        gb    = x.11^x.12
        pkB   = pk(x.13)
        sigB  = sign(x.11^x.12, x.13)
        z     = x.11^(x.12*~expA.14)
        z.1   = true
    
    13. gb    = DH_neutral
        pkB   = pkB.11
        sigB  = sigB.11
        z     = DH_neutral
        z.1   = verify(sigB.11, DH_neutral, pkB.11)
    
    14. gb    = DH_neutral
        pkB   = pk(x.11)
        sigB  = sign(DH_neutral, x.11)
        z     = DH_neutral
        z.1   = true
  */

rule (modulo E) Bob_Healing_Step:
   [
   State_Bob( $A, $B, rk0 ), In( <ga, sigA> ), !Ltk( $B, skB ),
   !Pk( $A, pkA ), Fr( ~expB )
   ]
  --[
  Eq( verify(sigA, ga, pkA), true ), Heal( $A, $B, h(kdf(rk0, ga^~expB)) )
  ]->
   [ Out( <'g'^~expB, sign('g'^~expB, skB)> ) ]

  /*
  rule (modulo AC) Bob_Healing_Step:
     [
     State_Bob( $A, $B, rk0 ), In( <ga, sigA> ), !Ltk( $B, skB ),
     !Pk( $A, pkA ), Fr( ~expB )
     ]
    --[ Eq( z, true ), Heal( $A, $B, h(kdf(rk0, z.1)) ) ]->
     [ Out( <'g'^~expB, sign('g'^~expB, skB)> ) ]
    variants (modulo AC)
    1. ~expB = ~expB.20
       ga    = ga.21
       pkA   = pkA.22
       sigA  = sigA.24
       z     = verify(sigA.24, ga.21, pkA.22)
       z.1   = ga.21^~expB.20
    
    2. ~expB = ~expB.51
       ga    = ga.52
       pkA   = pk(x.98)
       sigA  = sign(ga.52, x.98)
       z     = true
       z.1   = ga.52^~expB.51
    
    3. ~expB = ~expB.51
       ga    = x.97^x.98
       pkA   = pkA.53
       sigA  = sigA.55
       z     = verify(sigA.55, x.97^x.98, pkA.53)
       z.1   = x.97^(~expB.51*x.98)
    
    4. ~expB = ~expB.52
       ga    = x.98^x.99
       pkA   = pk(x.100)
       sigA  = sign(x.98^x.99, x.100)
       z     = true
       z.1   = x.98^(~expB.52*x.99)
    
    5. ga    = DH_neutral
       pkA   = pkA.22
       sigA  = sigA.24
       z     = verify(sigA.24, DH_neutral, pkA.22)
       z.1   = DH_neutral
    
    6. ga    = DH_neutral
       pkA   = pk(x.96)
       sigA  = sign(DH_neutral, x.96)
       z     = true
       z.1   = DH_neutral
  */

restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction OnlyOnceKeys:
  "∀ #i #j. ((UniqueKeys( ) @ #i) ∧ (UniqueKeys( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((UniqueKeys( ) @ #i) ∧ (UniqueKeys( ) @ #j)) ⇒ (#i = #j)"
  */

restriction OnlyOnceState:
  "∀ #i #j. ((UniqueState( ) @ #i) ∧ (UniqueState( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((UniqueState( ) @ #i) ∧ (UniqueState( ) @ #j)) ⇒ (#i = #j)"
  */

lemma PCS_Property_With_Sent_Msg:
  all-traces
  "∀ A B m rk #i #j #k.
    ((((Send( A, B, m ) @ #i) ∧ (K( m ) @ #j)) ∧ (Heal( A, B, rk ) @ #k)) ∧
     (#k < #i)) ⇒
    (∃ #l. (Compromise( A, B ) @ #l) ∧ (#k < #l))"
/*
guarded formula characterizing all counter-examples:
"∃ A B m rk #i #j #k.
  (Send( A, B, m ) @ #i) ∧ (K( m ) @ #j) ∧ (Heal( A, B, rk ) @ #k)
 ∧
  (#k < #i) ∧ (∀ #l. (Compromise( A, B ) @ #l) ⇒ ¬(#k < #l))"
*/
simplify
solve( St_Alice_1( $A, $B, rk0, ~expA ) ▶₀ #i )
  case Alice_Send_DH_case_1
  solve( !Pk( $B, pk(x) ) ▶₂ #i )
    case Initialize_Identities_case_1
    solve( Heal( $A, $A, rk ) @ #k )
      case Alice_Complete_Healing_And_Send
      solve( St_Alice_1( $A, $A, rk0.1, ~expA.1 ) ▶₀ #k )
        case Alice_Send_DH
        by contradiction /* cyclic */
      qed
    next
      case Bob_Healing_Step
      solve( State_Bob( $A, $A, rk0.1 ) ▶₀ #k )
        case Initialize_Shared_State
        solve( !Ltk( $A, skB ) ▶₂ #k )
          case Initialize_Identities_case_1
          solve( !Pk( $A, pk(x) ) ▶₃ #k )
            case Initialize_Identities_case_1
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(ga, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      by contradiction /* non-normal terms */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(ga, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      by contradiction /* non-normal terms */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(x^x.1, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      solve( !KU( 'g'^(~expA*~expA) ) @ #vk.7 )
                        case Alice_Send_DH
                        by solve( !KU( ~expA ) @ #vk.8 )
                      next
                        case c_exp
                        by solve( !KU( ~expA ) @ #vk.10 )
                      qed
                    next
                      case Bob_Healing_Step
                      by contradiction /* cyclic */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(x^x.1, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      solve( !KU( 'g'^(~expA*~expB) ) @ #vk.10 )
                        case Alice_Send_DH
                        by solve( !KU( ~expB ) @ #vk.11 )
                      next
                        case Bob_Healing_Step
                        by solve( !KU( ~expA ) @ #vk.11 )
                      next
                        case c_exp
                        by solve( !KU( ~expA ) @ #vk.13 )
                      qed
                    next
                      case Bob_Healing_Step
                      by contradiction /* cyclic */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(DH_neutral, ~skA) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(DH_neutral, ~skA) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          next
            case Initialize_Identities_case_2
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(ga, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(ga, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(x^x.1, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(x^x.1, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(DH_neutral, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case Bob_Healing_Step
                    solve( !KU( sign(DH_neutral, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          qed
        next
          case Initialize_Identities_case_2
          solve( !Pk( $A, pk(x) ) ▶₃ #k )
            case Initialize_Identities_case_1
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(ga, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      by contradiction /* non-normal terms */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(x^x.1, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      solve( !KU( 'g'^(~expA*~expA) ) @ #vk.7 )
                        case Alice_Send_DH
                        by solve( !KU( ~expA ) @ #vk.8 )
                      next
                        case c_exp
                        by solve( !KU( ~expA ) @ #vk.10 )
                      qed
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(DH_neutral, ~skA) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          next
            case Initialize_Identities_case_2
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(ga, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(x^x.1, ~skB) ) @ #vk.9 )
                      case Bob_Healing_Step
                      by contradiction /* cyclic */
                    next
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skA) ) @ #vk.6 )
                    case Alice_Send_DH
                    solve( !KU( sign(DH_neutral, ~skB) ) @ #vk.9 )
                      case c_sign
                      by solve( !KU( ~skB ) @ #vk.11 )
                    qed
                  next
                    case c_sign
                    by solve( !KU( ~skA ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  next
    case Initialize_Identities_case_2
    solve( Heal( $A, $B, rk ) @ #k )
      case Alice_Complete_Healing_And_Send
      solve( St_Alice_1( $A, $B, rk0.1, ~expA.1 ) ▶₀ #k )
        case Alice_Send_DH
        by contradiction /* cyclic */
      qed
    next
      case Bob_Healing_Step
      solve( State_Bob( $A, $B, rk0.1 ) ▶₀ #k )
        case Initialize_Shared_State
        solve( !Ltk( $B, skB.1 ) ▶₂ #k )
          case Initialize_Identities_case_1
          solve( !Pk( $A, pk(x) ) ▶₃ #k )
            case Initialize_Identities_case_1
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          next
            case Initialize_Identities_case_2
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                next
                  case split_case_2
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                next
                  case split_case_3
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case c_sign
                    by solve( !KU( ~skB ) @ #vk.11 )
                  qed
                qed
              qed
            qed
          qed
        next
          case Initialize_Identities_case_2
          solve( !Pk( $A, pk(x) ) ▶₃ #k )
            case Initialize_Identities_case_1
            solve( !KU( ~secret_msg ) @ #vk.3 )
              case Alice_Complete_Healing_And_Send
              solve( !KU( ~rk0 ) @ #vk.9 )
                case Reveal_RK
                solve( splitEqs(1) )
                  case split_case_1
                  solve( !KU( sign(gb, ~skB) ) @ #vk.6 )
                    case Bob_Healing_Step
                    solve( !KU( sign(ga, ~skA) ) @ #vk.9 )
                      case Alice_Send_DH
                      by contradiction /* non-normal terms */
                    next
                      case c_sign
                      by solve( !KU( ~skA ) @ #vk.11 )
                    qed
